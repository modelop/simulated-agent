# Minimal open-source Debian-based Python image
FROM python:3.12-slim

# Prevent Python from buffering stdout/stderr so logs show immediately in Docker
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Create non-root sandbox user and group
RUN groupadd --gid 1000 sandbox && \
    useradd --uid 1000 --gid sandbox --shell /bin/bash --create-home sandbox

# Install Node.js and npm from the official Debian repository, then clean up apt cache
RUN apt-get update && \
    apt-get install -y --no-install-recommends nodejs npm && \
    rm -rf /var/lib/apt/lists/*

# Install Python dependencies first for better Docker layer caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy Node configuration and initialize node_modules
COPY package.json .
RUN npm install

# Copy application code and start script
COPY hello.js main.py start.sh ./

# Ensure the start script is executable and has Unix (LF) line endings
# Ensure start.sh is executable, has Unix (LF) line endings, and sandbox owns /app
RUN sed -i 's/\r$//' start.sh && \
    chmod +x start.sh && \
    chown -R sandbox:sandbox /app

USER sandbox

CMD ["./start.sh"]